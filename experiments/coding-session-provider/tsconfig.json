{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "typeRoots": ["../../node_modules/@types"], "types": ["node"],
    "paths": {
      "@ai-sdk/provider": ["./fixture-sdk/@ai-sdk/provider/dist/index.d.ts"],
      "@ai-sdk/provider-utils": ["./fixture-sdk/@ai-sdk/provider-utils/dist/index.d.ts"],
      "zod": ["./fixture-sdk/zod/index.d.ts"],
      "zod/v4": ["./fixture-sdk/zod/v4/index.d.ts"]
    }
  },
  "include": ["*.ts", "test/*.test.ts"]
}
