{
  "name": "palimpsest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An autark with durable memory, self-improvement, and governed succession",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "test": "node deployment/test.mjs",
    "check": "tsc --noEmit",
