{
  "_metadata": { "major_version": 1 },
  "display_information": {
    "name": "Palimpsest",
    "description": "Local coding companion with durable memory and governed self-improvement"
  },
  "features": {
    "bot_user": { "display_name": "Palimpsest", "always_online": false }
  },
  "oauth_config": {
    "scopes": { "bot": ["app_mentions:read", "chat:write"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention"] },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
