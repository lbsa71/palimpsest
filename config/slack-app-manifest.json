{
  "_metadata": { "major_version": 1 },
  "display_information": {
    "name": "Palimpsest",
    "description": "Local coding companion with durable memory and governed self-improvement"
  },
  "features": {
    "app_home": { "home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false },
    "bot_user": { "display_name": "Palimpsest", "always_online": false }
  },
  "oauth_config": {
    "scopes": { "bot": ["app_mentions:read", "chat:write", "channels:history", "groups:history", "im:history", "reactions:write"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.channels", "message.groups", "message.im"] },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
